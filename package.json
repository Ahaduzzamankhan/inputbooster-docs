{
  "name": "inputbooster-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation for the InputBooster Minecraft client mod",
  "scripts": {
    "dev": "node scripts/build-search-index.mjs && next dev",
    "build": "node scripts/build-search-index.mjs && next build && node scripts/copy-og-image.mjs",
    "start": "node scripts/serve-export.mjs",
    "serve": "node scripts/serve-export.mjs",
    "typecheck": "tsc --noEmit",
